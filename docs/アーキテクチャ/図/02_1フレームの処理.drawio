<mxfile host="drawio"><diagram id="d" name="1フレームの処理"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="820" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c2" value="1フレームの処理順（main.js frame() → swe.js → world.js）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#10222e;fontSize=22;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="① ステップ数の決定&lt;br&gt;再生速度×経過時間 ÷ dt&lt;br&gt;上限 maxSteps（fpsで適応）&lt;br&gt;ネスト：広域→詳細を同時刻へ&lt;br&gt;水が遠い間は詳細を待機" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c4" value="② SSP-RK2 × n 回&lt;br&gt;stage1：A → B&lt;br&gt;stage2：(A+B)/2 → A&lt;br&gt;＋造波帯／ネスト緩和&lt;br&gt;renderer.compute([…]) 一括" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="405" y="110" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c5" value="③ aux（1回）&lt;br&gt;T0⇄T1 移流&lt;br&gt;泡・濁り・濡れ&lt;br&gt;最大値M・到達時刻&lt;br&gt;飛沫の発生（atomic）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c6" value="④ 破堤判定&lt;br&gt;breachKernel&lt;br&gt;堤防セルに水 &amp;gt; 5cm&lt;br&gt;→ 地盤まで下げる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1135" y="110" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c7" value="⑤ pack&lt;br&gt;R（描画水位・法線・水深）&lt;br&gt;R2（泡・濁り・流速）&lt;br&gt;surfTex／envTex へ&lt;br&gt;textureStore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c8" value="⑥ プローブ&lt;br&gt;海岸水位の平均/最大&lt;br&gt;水の先端距離・破堤数&lt;br&gt;地点1セル（16B×2）&lt;br&gt;→ 非同期で読み戻し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c9" value="⑦ 飛沫の更新&lt;br&gt;重力・抵抗・寿命&lt;br&gt;水面や壁で消滅&lt;br&gt;（停止中は更新しない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="405" y="410" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c10" value="⑧ コースティクス&lt;br&gt;光子格子（≤1024²）&lt;br&gt;面積比 → causticRT&lt;br&gt;2フレームに1回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="770" y="410" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c11" value="⑨ シーン描画&lt;br&gt;地形・建物・防潮壁&lt;br&gt;水面（頂点=セル）&lt;br&gt;広域・飛沫・空&lt;br&gt;影マップは静的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1135" y="410" width="320" height="220" as="geometry"/></mxCell>
<mxCell id="c12" value="⑩ ポスト＆表示&lt;br&gt;Bloom → AgX&lt;br&gt;CSS2D ラベル&lt;br&gt;HUD 更新（6フレーム毎）&lt;br&gt;適応解像度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1500" y="410" width="320" height="220" as="geometry"/></mxCell>
