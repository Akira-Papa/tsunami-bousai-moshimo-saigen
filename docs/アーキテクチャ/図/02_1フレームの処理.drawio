<mxCell id="c22" value="赤：GPU計算（compute pass）　紫：描画（render pass）&lt;br&gt;1ステップ = 2 dispatch。768²格子・dt≈0.02秒。×20再生なら1フレームで約30ステップ。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#44535e;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1800" height="60" as="geometry"/></mxCell>
