<mxfile host="drawio"><diagram id="d" name="二段ネスト計算"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c2" value="内陸の地点（例：名古屋駅）の二段ネスト計算" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#10222e;fontSize=22;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="広域（外側）ソルバー&lt;br&gt;最大20km四方・1024²（約14m）&lt;br&gt;建物は粗度（n = 0.045〜0.09）&lt;br&gt;満潮位・防潮壁・破堤は同条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4fb;strokeColor=#4f8fbf;fontColor=#1d2a33;fontSize=15;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="820" height="820" as="geometry"/></mxCell>
<mxCell id="c4" value="海（造波帯：範囲の4%幅、τ=2.5秒、リーマン不変量）&lt;br&gt;開けた海を最寄りの広い水面から3.5km先まで含める" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe6f5;strokeColor=#4f8fbf;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="780" height="130" as="geometry"/></mxCell>
<mxCell id="c5" value="港・ゼロメートル地帯&lt;br&gt;防潮壁を越えた所から破堤&lt;br&gt;運河・川沿いに浸水が広がる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8aa5b8;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="560" width="380" height="150" as="geometry"/></mxCell>
<mxCell id="c6" value="詳細（内側）ソルバー&lt;br&gt;地点の周り1.5km四方&lt;br&gt;768²（約2m）&lt;br&gt;建物＝反射壁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=14;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="260" height="260" as="geometry"/></mxCell>
<mxCell id="c7" value="押し波" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3b6f8f;strokeWidth=1.6;fontSize=11;fontFamily=Hiragino Sans;fontColor=#33434e;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" value="水の先端が近づく" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3b6f8f;strokeWidth=1.6;fontSize=11;fontFamily=Hiragino Sans;fontColor=#33434e;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" value="縁の結合（一方向ネスト）&lt;br&gt;・内側の縁から70mの帯で、外側解（h, hu, hv, z）を双線形補間&lt;br&gt;・水位 η を共有し、深さ＝η−細かい地盤&lt;br&gt;・外側が乾いている所は緩和しない&lt;br&gt;・帯の外の縁ゴーストは流出のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6b78;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="90" width="500" height="250" as="geometry"/></mxCell>
<mxCell id="c10" value="時間の同期&lt;br&gt;・毎フレーム、外側を先に進める&lt;br&gt;・内側は外側と同じ時刻まで dt≈0.02秒で進める&lt;br&gt;・水の先端が「内側の0.75倍＋600m」より遠い間は&lt;br&gt;　内側を計算せず時計だけ進める（idle）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6b78;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="360" width="500" height="220" as="geometry"/></mxCell>
<mxCell id="c11" value="表示&lt;br&gt;・視点「広域」で海から地点までを一望&lt;br&gt;・外側の水面は outer.js（同じ w_water）&lt;br&gt;・内側の四角の中は詳細側が描く&lt;br&gt;・HUD「水の先端まで」＝外側/内側の近い方&lt;br&gt;・再現時間 約90分（高い水位を60分保持）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6b78;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="600" width="500" height="220" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>