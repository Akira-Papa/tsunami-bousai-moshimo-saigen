<mxfile host="drawio"><diagram id="d" name="テクスチャとGPUリソース"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1160" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c2" value="テクスチャ・GPUリソースの対応図（誰が書き、誰が読むか）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#10222e;fontSize=22;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="つくるもの（書き込み元）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#9aaab6;fontColor=#1d2a33;fontSize=15;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=8;arcSize=8;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="520" height="1050" as="geometry"/></mxCell>
<mxCell id="c4" value="photoTex（CanvasTexture・sRGB・ミップマップ）&lt;br&gt;地理院航空写真 z16〜17 を 3072〜4096px に貼り合わせ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#7ea6cf;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c5" value="bedTex（DataTexture・RGBA 半精度・N×N）&lt;br&gt;R=地盤/海底　G=建物の高さ　B=海フラグ&lt;br&gt;A=日が当たる最低水位（読み込み時に64歩で焼き込み）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f4f1;strokeColor=#4fae9c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="480" height="100" as="geometry"/></mxCell>
<mxCell id="c6" value="surfTex（StorageTexture・RGBA 半精度）&lt;br&gt;R=描画水深　G,B=水面法線　A=濁り&lt;br&gt;← pack カーネルが毎フレーム textureStore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c7" value="envTex（StorageTexture・RGBA 半精度）&lt;br&gt;R=濡れ　G=最大水深　B=泡　A=最大水位−地盤&lt;br&gt;← pack カーネルが毎フレーム textureStore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c8" value="causticRT（RenderTarget・半精度・≤2048²）&lt;br&gt;光子格子を加算合成（面積比 → 光の集まり）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="480" height="80" as="geometry"/></mxCell>
<mxCell id="c9" value="offTex（CanvasTexture 2048²）&lt;br&gt;公式想定100mセルを深さ色の斜線＋輪郭で描画" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f6ec;strokeColor=#7fb58d;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="480" height="80" as="geometry"/></mxCell>
<mxCell id="c10" value="R / R2（ストレージバッファ・f32 vec4）&lt;br&gt;描画水位・法線・水深／泡・濁り・流速" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="745" width="480" height="80" as="geometry"/></mxCell>
<mxCell id="c11" value="P / V（ストレージバッファ）　飛沫の位置・寿命／速度・大きさ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="480" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="外周 photo（z13〜14）＋ mask（海=白）／広域 bedTex・photo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#7ea6cf;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="925" width="480" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="影マップ（2048² / 4096²）　太陽は固定 → autoUpdate=false で1回だけ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="480" height="70" as="geometry"/></mxCell>
<mxCell id="c14" value="つかうもの（読む側）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#9aaab6;fontColor=#1d2a33;fontSize=15;fontFamily=Hiragino Sans;align=left;verticalAlign=top;spacing=8;arcSize=8;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1250" y="80" width="610" height="1050" as="geometry"/></mxCell>
<mxCell id="c15" value="水面 w_water（MeshBasicNodeMaterial＋WGSL）&lt;br&gt;屈折先の水底＝photoTex／海底色、日影＝bedTex.A&lt;br&gt;建物の映り込み＝bedTex.G をレイマーチ&lt;br&gt;コースティクス＝causticRT＋近景worley" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="125" width="570" height="110" as="geometry"/></mxCell>
<mxCell id="c16" value="水面の頂点（vertexIndex で R / R2 を直接読む）&lt;br&gt;頂点1つ＝計算セル1つ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="250" width="570" height="90" as="geometry"/></mxCell>
<mxCell id="c17" value="コースティクスの光子格子&lt;br&gt;surfTex を読んで屈折 → 水底への到達点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="355" width="570" height="90" as="geometry"/></mxCell>
<mxCell id="c18" value="地形（MeshStandardNodeMaterial）&lt;br&gt;photoTex × 濡れて暗く（envTex.R）&lt;br&gt;泥の膜（envTex.G）・海底色（bedTex.B）&lt;br&gt;公式想定の斜線（offTex）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="460" width="570" height="110" as="geometry"/></mxCell>
<mxCell id="c19" value="建物（押し出し）&lt;br&gt;壁＝手続き的な窓と色、屋根＝photoTex&lt;br&gt;泥線＝外側で読んだ envTex.A の高さまで暗く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="585" width="570" height="100" as="geometry"/></mxCell>
<mxCell id="c20" value="飛沫スプライト（Sprite.count＝2^17）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="700" width="570" height="70" as="geometry"/></mxCell>
<mxCell id="c21" value="外周（1段）／広域の地形と水面（ネスト）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="785" width="570" height="80" as="geometry"/></mxCell>
<mxCell id="c22" value="地形・建物・防潮壁の影" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="880" width="570" height="70" as="geometry"/></mxCell>
