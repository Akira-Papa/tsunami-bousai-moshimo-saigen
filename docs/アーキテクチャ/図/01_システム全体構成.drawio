<mxCell id="c26" value="非線形浅水方程式ソルバー&lt;br&gt;MUSCL-minmod＋Audusse静水圧再構成&lt;br&gt;HLL（Einfeldt）＋SSP-RK2（2 dispatch/step）&lt;br&gt;Manning摩擦・脱特異化・速度上限15m/s&lt;br&gt;建物＝反射壁／防潮壁＝越流で破堤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6b78;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="615" width="440" height="195" as="geometry"/></mxCell>
