<mxfile host="drawio"><diagram id="d" name="データフロー"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="700" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c2" value="データフロー：地点 → 計画 → 地域（格子） → GPUバッファ → 描画" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#10222e;fontSize=22;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="地点（緯度・経度）&lt;br&gt;＋ 海の高さ H&lt;br&gt;＋ 潮位・防潮壁の天端&lt;br&gt;＋ 格子数 N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e0a14a;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="230" height="120" as="geometry"/></mxCell>
<mxCell id="c4" value="planDomain&lt;br&gt;近傍4.2km（z14・20m）&lt;br&gt;→ 1段：1.5〜4km四方&lt;br&gt;遠方16km（z12・60m）&lt;br&gt;→ ネスト：広域 最大20km" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f4f1;strokeColor=#4fae9c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="c5" value="buildRegion（詳細）&lt;br&gt;ground / water / sea&lt;br&gt;dist（面取り距離変換）&lt;br&gt;bed（合成水深 3+s/8, ≤14m）&lt;br&gt;eta0 / bldH / bldId&lt;br&gt;leveeZ（天端）&lt;br&gt;photo / official" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f4f1;strokeColor=#4fae9c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="770" y="80" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="c6" value="buildOuterRegion（広域）&lt;br&gt;同上＋ manning&lt;br&gt;（堅ろう建物の被覆率&lt;br&gt;→ n = 0.045〜0.09）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f4f1;strokeColor=#4fae9c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=center;verticalAlign=middle;spacing=8;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="770" y="300" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="c7" value="createSolver → GPUバッファ（f32 vec4）&lt;br&gt;&lt;br&gt;S：(z, 壁, n, 乾いた陸)&lt;br&gt;W：(造波の重み, 岸向き x,z, 水深)&lt;br&gt;A / B：(h, hu, hv, _)　SSP-RK2&lt;br&gt;T0 / T1：(泡, 濁り, 濡れ, 前フレームη)&lt;br&gt;M：(最大水深, 到達時刻, 最大流速, 最大η)&lt;br&gt;LV / LI：防潮壁（天端・地盤・破堤）&lt;br&gt;P / V：飛沫粒子 2^17&lt;br&gt;R / R2：描画用（水位・法線・水深／泡・濁り・流速）&lt;br&gt;surfTex / envTex：半精度テクスチャ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e6;strokeColor=#d46a5c;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1220" y="80" width="400" height="370" as="geometry"/></mxCell>
<mxCell id="c8" value="描画で読むもの&lt;br&gt;&lt;br&gt;水面：R / R2 を vertexIndex で直接読む&lt;br&gt;＋ photoTex / bedTex / causticRT&lt;br&gt;コースティクス：surfTex&lt;br&gt;地形：photoTex ＋ envTex（濡れ・泥）&lt;br&gt;建物：envTex（泥線）＋ photoTex（屋根）&lt;br&gt;防潮壁：S / LV / LI（壊れると消える）&lt;br&gt;飛沫：P / V&lt;br&gt;広域：外側ソルバーの R / R2 / envTex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9fb;strokeColor=#8a74c9;fontColor=#1d2a33;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1770" y="80" width="400" height="370" as="geometry"/></mxCell>
<mxCell id="c9" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3b6f8f;strokeWidth=1.6;fontSize=11;fontFamily=Hiragino Sans;fontColor=#33434e;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" value="1段/詳細" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3b6f8f;strokeWidth=1.6;fontSize=11;fontFamily=Hiragino Sans;fontColor=#33434e;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" value="ネスト時" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3b6f8f;strokeWidth=1.6;fontSize=11;fontFamily=Hiragino Sans;fontColor=#33434e;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c12" value="region" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3b6f8f;strokeWidth=1.6;fontSize=11;fontFamily=Hiragino Sans;fontColor=#33434e;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2702702702702703;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" value="outer region" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3b6f8f;strokeWidth=1.6;fontSize=11;fontFamily=Hiragino Sans;fontColor=#33434e;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7972972972972973;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" value="毎フレーム pack" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3b6f8f;strokeWidth=1.6;fontSize=11;fontFamily=Hiragino Sans;fontColor=#33434e;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c15" value="格子化のルール（region.js）&lt;br&gt;・標高の無効値（x=2^23）＝水面。領域の縁につながる水面＝海、それ以外＝池（周囲の最低地盤−1.5m）&lt;br&gt;・建物：セル中心がポリゴン内なら壁。木造（普通建物）は縮めず、他は1/4セル内側に縮めて路地を残す。水上の建物は除外&lt;br&gt;・高さ：PLATEAU measuredHeight → 階数×3.2+0.8 → 地理院の種別（堅ろう 9〜21m、高層 30〜60m、普通 5.8〜8m、無壁舎 3.2〜4.2m）&lt;br&gt;・防潮壁：地理院線（5103/5203/5515）の周りの「水に接する陸セル」に天端 max(地盤+0.3, 天端)&lt;br&gt;・ネストの広域は建物を壁にせず粗度で表す（約14mセルでは道路を解像できないため）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#44535e;fontSize=13;fontFamily=Hiragino Sans;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="2100" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>